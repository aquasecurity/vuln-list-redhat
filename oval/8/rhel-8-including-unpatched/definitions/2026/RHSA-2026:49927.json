    "Title": "RHSA-2026:49927: fence-agents security update (Moderate)",
    "AffectedList": [
      {
        "Family": "unix",
        "Platforms": [
          "Red Hat Enterprise Linux 8"
        ]
      }
    ],
    "References": [
      {
