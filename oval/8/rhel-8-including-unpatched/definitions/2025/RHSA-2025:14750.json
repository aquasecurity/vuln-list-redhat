    "Title": "RHSA-2025:14750: fence-agents security update (Moderate)",
    "AffectedList": [
      {
        "Family": "unix",
        "Platforms": [
          "Red Hat Enterprise Linux 8"
        ]
      }
    ],
    "References": [
      {
