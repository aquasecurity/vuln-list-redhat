    "Title": "RHSA-2025:15622: fence-agents security update (Moderate)",
    "AffectedList": [
      {
        "Family": "unix",
        "Platforms": [
          "Red Hat Enterprise Linux 8.4 Advanced Mission Critical Update Support"
        ]
      }
    ],
    "References": [
      {
        "Source": "RHSA",
        "RefID": "RHSA-2025:15622",
