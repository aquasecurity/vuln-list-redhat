    "Title": "RHSA-2026:2221: fence-agents security update (Important)",
    "AffectedList": [
      {
        "Family": "unix",
        "Platforms": [
          "Red Hat Enterprise Linux 8.8 Update Services for SAP Solutions"
        ]
      }
    ],
    "References": [
      {
