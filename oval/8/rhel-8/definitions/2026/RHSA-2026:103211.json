    "Title": "RHSA-2026:103211: fence-agents security update (Critical)",
    "AffectedList": [
      {
        "Family": "unix",
        "Platforms": [
          "Red Hat Enterprise Linux 8"
        ]
      }
    ],
    "References": [
      {
