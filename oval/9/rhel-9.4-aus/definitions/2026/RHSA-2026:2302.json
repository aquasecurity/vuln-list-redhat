    "Title": "RHSA-2026:2302: fence-agents security update (Important)",
    "AffectedList": [
      {
        "Family": "unix",
        "Platforms": [
          "Red Hat Enterprise Linux 9.4 Extended Update Support"
        ]
      }
    ],
    "References": [
